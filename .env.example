NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=orbit
DB_USER=orbit_app
DB_PASSWORD=
# Set only when there is exactly one trusted reverse proxy in front of Node.
TRUST_PROXY=0
# Keep false while Unity is being developed. Publish a reviewed WebGL build before enabling.
UNITY_WEBGL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contacto.orbit.bo@gmail.com
SMTP_PASSWORD=
MAIL_FROM=ORBIT <contacto.orbit.bo@gmail.com>
# Google OAuth: web application credentials. The secret stays on the server.
# Authorized redirect: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional manual payments: disabled until complete receiving details are provided.
PAYMENT_ENABLED=false
PAYMENT_HOLDER=
PAYMENT_BANK=
PAYMENT_ACCOUNT=
PAYMENT_QR_URL=
